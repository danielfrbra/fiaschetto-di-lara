---
/**
 * Un video di sfondo, oppure un placeholder curato finché il clip non c'è.
 * - `eager` (solo l'apertura): sotto c'è il poster come IMMAGINE responsive (WebP + JPEG, 800 o 1280 px),
 *   che è la prima cosa dipinta; il video parte appena la pagina ha finito di caricare (script in Base.astro).
 *   Poster = primo fotogramma, quindi il passaggio non si vede.
 * - gli altri si caricano quando si avvicinano allo schermo, così la home non scarica quattro video in una volta.
 * - Con "riduci movimento" attivo, resta il poster e il video non parte.
 */
import type { Clip } from "../config/media";
interface Props { clip: Clip; class?: string; showLabel?: boolean; eager?: boolean }
const { clip, class: cls = "", showLabel = false, eager = false } = Astro.props;
const webp = (p: string) => p.replace(/\.jpg$/, ".webp");
---
{clip.src ? (
  eager ? (
    <div class={`media-wrap ${cls}`}>
      {clip.poster && (
        <picture>
          {clip.webp && <source type="image/webp" srcset={`${webp(clip.posterSmall ?? clip.poster)} 800w, ${webp(clip.poster)} 1280w`} sizes="100vw" />}
          <img class="media" src={clip.poster} srcset={clip.posterSmall ? `${clip.posterSmall} 800w, ${clip.poster} 1280w` : undefined} sizes="100vw" width="1280" height="720" alt="" fetchpriority="high" decoding="async" />
        </picture>
      )}
      <video class="media media-over" data-src={clip.src} data-eager muted loop playsinline preload="none" aria-hidden="true"></video>
    </div>
  ) : (
    <video class={`media ${cls}`} data-src={clip.src} poster={clip.posterSmall ?? clip.poster ?? undefined} muted loop playsinline preload="none" aria-hidden="true"></video>
  )
) : (
  <div class={`media media-ph ${cls}`} aria-hidden="true">
    {showLabel && <span class="ph-label">{clip.label}</span>}
  </div>
)}

<style>
  .media { width: 100%; height: 100%; object-fit: cover; background: var(--ink); display: block; }
  .media-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .media-wrap picture, .media-wrap .media { position: absolute; inset: 0; width: 100%; height: 100%; }
  .media-over { opacity: 0; transition: opacity 0.8s ease; }
  .media-over.playing { opacity: 1; }
  .media-ph {
    position: relative; overflow: hidden;
    background:
      radial-gradient(60% 70% at 80% 20%, rgba(225, 185, 107, 0.22), transparent 60%),
      radial-gradient(50% 60% at 15% 85%, rgba(107, 26, 43, 0.9), transparent 65%),
      linear-gradient(160deg, #3a0f1c, #2a0b14 55%, #1d070e);
  }
  .media-ph::before, .media-ph::after {
    content: ""; position: absolute; inset: -30%;
    background: radial-gradient(closest-side, rgba(225, 185, 107, 0.18), transparent 70%);
    animation: breathe 16s ease-in-out infinite alternate;
  }
  .media-ph::after { background: radial-gradient(closest-side, rgba(120, 30, 50, 0.6), transparent 70%); animation-duration: 22s; animation-direction: alternate-reverse; }
  @keyframes breathe {
    from { transform: translate(-8%, 6%) scale(1); }
    to { transform: translate(10%, -8%) scale(1.15); }
  }
  .ph-label {
    position: absolute; left: 1rem; bottom: 1rem; z-index: 1;
    font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
    color: rgba(246, 238, 224, 0.5); border: 1px solid rgba(246, 238, 224, 0.25); border-radius: 999px; padding: 0.3rem 0.7rem;
  }
</style>
